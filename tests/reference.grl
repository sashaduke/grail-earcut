use earcut;

// Returns 1 when the triangle list differs from the C++ result.
fn check(name: &[u8], got: u64[], want: u64[]) -> u64 {
    if got.len() != want.len() {
        println("{}: {} indices, expected {}", name, got.len(), want.len());
        return 1;
    }
    for i in got.len() {
        if got[i] != want[i] {
            println("{}: index {} is {}, expected {}", name, i, got[i], want[i]);
            return 1;
        }
    }
    println("{}: ok ({} triangles)", name, got.len() / 3);
    return 0;
}

